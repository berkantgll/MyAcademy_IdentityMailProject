@model IdentityMail.Web.DTOs.UserDtos.LoginDto

@{
    ViewData["Title"] = "Giriş Yap";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giriş Yap | Nexora</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <style>
            :root {
                --primary: #6366f1;
                --primary-dark: #4f46e5;
                --text: #172033;
                --muted: #8490a5;
                --border: #e5e9f2;
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Inter', sans-serif;
                color: var(--text);
                background: #f4f6fb;
            }

            .auth-container {
                display: grid;
                grid-template-columns: 46% 54%;
                min-height: 100vh;
            }

            /* SOL PANEL — REGISTER İLE AYNI TASARIM */
            .auth-left {
                position: relative;
                isolation: isolate;
                overflow: hidden;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                padding: 55px 65px;
                color: #fff;
                background: linear-gradient(145deg, #10172e 0%, #1b2450 52%, #332b77 100%);
            }

                .auth-left::before {
                    content: "";
                    position: absolute;
                    z-index: -1;
                    width: 450px;
                    height: 450px;
                    right: -150px;
                    bottom: -180px;
                    border-radius: 50%;
                    background: #6366f1;
                    filter: blur(150px);
                    opacity: .28;
                }

            .brand {
                display: flex;
                align-items: center;
                gap: 12px;
                font-size: 25px;
                font-weight: 800;
                letter-spacing: -1px;
            }

            .brand-icon {
                display: flex;
                align-items: center;
                justify-content: center;
                width: 44px;
                height: 44px;
                flex-shrink: 0;
                border-radius: 14px;
                background: linear-gradient(135deg, #818cf8, #6366f1);
                font-size: 23px;
            }

            .brand-name {
                white-space: nowrap;
            }

                .brand-name span {
                    color: #a5b4fc;
                }

            .left-content {
                max-width: 500px;
            }

            .left-badge {
                display: inline-block;
                padding: 9px 16px;
                margin-bottom: 25px;
                border: 1px solid rgba(255,255,255,.15);
                border-radius: 30px;
                background: rgba(255,255,255,.07);
                color: #c7d2fe;
                font-size: 12px;
                font-weight: 600;
            }

            .left-content h1 {
                max-width: 480px;
                margin-bottom: 22px;
                font-size: clamp(32px, 3.5vw, 49px);
                line-height: 1.16;
                letter-spacing: -2px;
                font-weight: 800;
            }

                .left-content h1 span {
                    color: #a5b4fc;
                }

            .left-content p {
                max-width: 400px;
                color: #aeb9d4;
                font-size: 15px;
                line-height: 1.9;
            }

            .mail-preview {
                margin-top: 45px;
                padding: 22px;
                border: 1px solid rgba(255,255,255,.13);
                border-radius: 20px;
                background: rgba(255,255,255,.09);
                backdrop-filter: blur(12px);
                box-shadow: 0 25px 55px rgba(0,0,0,.15);
            }

            .preview-title {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 18px;
                font-size: 14px;
                font-weight: 700;
            }

            .preview-count {
                padding: 5px 10px;
                border-radius: 20px;
                background: #6366f1;
                font-size: 11px;
            }

            .preview-message {
                display: flex;
                align-items: center;
                gap: 13px;
                padding: 14px;
                margin-bottom: 10px;
                border-radius: 12px;
                background: rgba(255,255,255,.09);
            }

                .preview-message:last-child {
                    margin-bottom: 0;
                }

            .avatar {
                display: flex;
                align-items: center;
                justify-content: center;
                width: 40px;
                height: 40px;
                flex-shrink: 0;
                border-radius: 12px;
                font-size: 13px;
                font-weight: 700;
            }

            .avatar-one {
                background: #b8e6db;
                color: #166653;
            }

            .avatar-two {
                background: #f9d8b3;
                color: #98551d;
            }

            .preview-message strong {
                display: block;
                margin-bottom: 5px;
                font-size: 12px;
            }

            .preview-message small {
                display: block;
                color: #b9c2d9;
                font-size: 11px;
            }

            .left-footer {
                font-size: 12px;
                color: #8793b4;
            }

            /* SAĞ PANEL — LOGIN FORMU */
            .auth-right {
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 55px 45px;
                background: #fff;
            }

            .form-wrapper {
                width: 100%;
                max-width: 480px;
            }

            .form-label-top {
                display: inline-block;
                margin-bottom: 16px;
                color: var(--primary);
                font-size: 12px;
                font-weight: 700;
                letter-spacing: 1.4px;
            }

            .form-wrapper h2 {
                margin-bottom: 12px;
                font-size: 32px;
                font-weight: 800;
                letter-spacing: -1.3px;
            }

            .form-description {
                margin-bottom: 34px;
                color: var(--muted);
                font-size: 14px;
                line-height: 1.8;
            }

            .form-group {
                margin-bottom: 22px;
            }

                .form-group label {
                    display: block;
                    margin-bottom: 9px;
                    color: #38445c;
                    font-size: 13px;
                    font-weight: 600;
                }

            .form-control {
                display: block;
                width: 100%;
                height: 49px;
                padding: 0 15px;
                border: 1px solid var(--border);
                border-radius: 11px;
                outline: none;
                background: #fafbfe;
                color: var(--text);
                font-family: inherit;
                font-size: 13px;
                transition: all .2s ease;
            }

                .form-control::placeholder {
                    color: #a3adbd;
                }

                .form-control:focus {
                    border-color: var(--primary);
                    background: white;
                    box-shadow: 0 0 0 4px rgba(99,102,241,.09);
                }

                .form-control.input-validation-error {
                    border-color: #ef4444;
                }

            .password-wrapper {
                position: relative;
            }

                .password-wrapper .form-control {
                    padding-right: 82px;
                }

            .password-toggle {
                position: absolute;
                top: 50%;
                right: 13px;
                transform: translateY(-50%);
                padding: 8px;
                border: 0;
                background: transparent;
                color: #777f94;
                cursor: pointer;
                font-family: inherit;
                font-size: 12px;
                font-weight: 600;
            }

                .password-toggle:hover {
                    color: var(--primary);
                }

            .forgot-password {
                margin: -7px 0 20px;
                text-align: right;
            }

                .forgot-password a {
                    color: var(--primary);
                    font-size: 12px;
                    font-weight: 600;
                    text-decoration: none;
                }

                    .forgot-password a:hover {
                        text-decoration: underline;
                    }

            .validation-summary-errors {
                margin-bottom: 20px;
                padding: 13px 17px;
                border: 1px solid #fecaca;
                border-radius: 10px;
                background: #fff1f2;
                color: #dc2626;
                font-size: 12px;
            }

                .validation-summary-errors ul {
                    margin: 0;
                    padding-left: 15px;
                }

            .field-validation-error {
                display: block;
                margin-top: 7px;
                color: #dc2626;
                font-size: 11px;
            }

            .login-btn {
                width: 100%;
                height: 52px;
                margin-top: 8px;
                border: 0;
                border-radius: 12px;
                background: linear-gradient(135deg, #6366f1, #4f46e5);
                color: #fff;
                cursor: pointer;
                font-family: inherit;
                font-size: 14px;
                font-weight: 700;
                box-shadow: 0 8px 20px rgba(99,102,241,.2);
                transition: all .2s ease;
            }

                .login-btn:hover {
                    transform: translateY(-1px);
                    background: linear-gradient(135deg, #5558e9, #4338ca);
                    box-shadow: 0 12px 25px rgba(99,102,241,.28);
                }

                .login-btn:active {
                    transform: translateY(0);
                }

            .register-link {
                margin-top: 28px;
                text-align: center;
                color: var(--muted);
                font-size: 13px;
            }

                .register-link a {
                    margin-left: 5px;
                    color: var(--primary);
                    font-weight: 700;
                    text-decoration: none;
                }

                    .register-link a:hover {
                        text-decoration: underline;
                    }

            .form-footer {
                margin-top: 42px;
                text-align: center;
                color: #a8b0bf;
                font-size: 11px;
            }

            /* MOBİL UYUM */
            @@media (max-width: 1100px) {
                .auth-left {
                    padding: 45px 35px;
                }

                .auth-right {
                    padding: 40px 30px;
                }
            }

            @@media (max-width: 850px) {
                .auth-container {
                    grid-template-columns: 1fr;
                }

                .auth-left {
                    display: none;
                }

                .auth-right {
                    min-height: 100vh;
                    padding: 45px 25px;
                }
            }

            @@media (max-width: 480px) {
                .form-wrapper h2 {
                    font-size: 28px;
                }

                .auth-right {
                    padding: 35px 20px;
                }
            }
    </style>
</head>
<body>
    <main class="auth-container">

        <!-- SOL TANITIM PANELİ -->
        <section class="auth-left">
            <div class="brand">
                <div class="brand-icon">✉</div>
                <div class="brand-name">Nex<span>ora.</span></div>
            </div>

            <div class="left-content">
                <div class="left-badge">✦ YENİ NESİL MESAJLAŞMA</div>

                <h1>
                    Sohbetlerine <span>kaldığın yerden devam et.</span>
                </h1>

                <p>
                    Mesajların, bağlantıların ve tüm iletişimin tek bir yerde.
                    Nexora hesabına giriş yap, dünyanla yeniden buluş.
                </p>

                <div class="mail-preview">
                    <div class="preview-title">
                        <span>Gelen Kutusu</span>
                        <span class="preview-count">2 Yeni</span>
                    </div>

                    <div class="preview-message">
                        <div class="avatar avatar-one">AY</div>
                        <div>
                            <strong>Ayşe Yılmaz</strong>
                            <small>Merhaba! Yeni projeyi inceledim...</small>
                        </div>
                    </div>

                    <div class="preview-message">
                        <div class="avatar avatar-two">MK</div>
                        <div>
                            <strong>Mehmet Kaya</strong>
                            <small>Toplantı detaylarını paylaştım.</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="left-footer">
                © @DateTime.Now.Year Nexora. Tüm hakları saklıdır.
            </div>
        </section>

        <!-- SAĞ GİRİŞ FORMU -->
        <section class="auth-right">
            <div class="form-wrapper">
                <span class="form-label-top">NEXORA'YA HOŞ GELDİN</span>
                <h2>Tekrar hoş geldin.</h2>
                <p class="form-description">
                    Hesabına giriş yap ve mesajlaşmaya kaldığın yerden devam et.
                </p>

                <form asp-controller="Auth" asp-action="Login" method="post">
                    <div class="form-group">
                        <label asp-for="Email">E-posta Adresi</label>
                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               placeholder="ornek@email.com"
                               autocomplete="email"
                               required />
                        <span asp-validation-for="Email"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password">Şifre</label>
                        <div class="password-wrapper">
                            <input asp-for="Password"
                                   type="password"
                                   class="form-control"
                                   placeholder="Şifreni gir"
                                   autocomplete="current-password"
                                   required />
                            <button type="button"
                                    class="password-toggle"
                                    data-password-toggle="Password"
                                    aria-label="Şifreyi göster"
                                    aria-pressed="false">
                                Göster
                            </button>
                        </div>
                        <span asp-validation-for="Password"></span>
                    </div>

                    <div class="forgot-password">
                        <a asp-controller="Auth" asp-action="ForgotPassword">
                            Şifremi Unuttum
                        </a>
                    </div>

                    <div asp-validation-summary="All"></div>

                    <button type="submit" class="login-btn">
                        Giriş Yap &rarr;
                    </button>
                </form>

                <div class="register-link">
                    Henüz hesabın yok mu?
                    <a asp-controller="Auth" asp-action="Register">Hesap Oluştur</a>
                </div>

                <div class="form-footer">
                    © @DateTime.Now.Year Nexora · Güvenli ve modern iletişim
                </div>
            </div>
        </section>
    </main>

    <script>
            document.querySelectorAll('[data-password-toggle]').forEach(function(button) {
                button.addEventListener('click', function() {
                    const input = document.getElementById(button.dataset.passwordToggle);
                    if (!input) return;

                    const wasVisible = input.type === 'text';
                    input.type = wasVisible ? 'password' : 'text';
                    button.textContent = wasVisible ? 'Göster' : 'Gizle';
                    button.setAttribute('aria-pressed', String(!wasVisible));
                    button.setAttribute('aria-label', wasVisible ? 'Şifreyi göster' : 'Şifreyi gizle');
                });
            });
    </script>
</body>
</html>


