@model IdentityMail.Web.DTOs.UserDtos.RegisterDto

@{
    ViewData["Title"] = "Kayıt Ol";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Kayıt Ol | Nexora</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <style>
            :root {
                --primary: #6366f1;
                --primary-dark: #4f46e5;
                --text: #172033;
                --muted: #8490a5;
                --border: #e5e9f2;
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Inter', sans-serif;
                background: #f4f6fb;
                color: var(--text);
            }

            .auth-container {
                min-height: 100vh;
                display: grid;
                grid-template-columns: 46% 54%;
            }

            /* SOL TANITIM ALANI */

            .auth-left {
                position: relative;
                overflow: hidden;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                padding: 55px 65px;
                color: white;
                background: linear-gradient( 145deg, #10172e 0%, #1b2450 52%, #332b77 100% );
            }

                .auth-left::before {
                    content: "";
                    position: absolute;
                    width: 450px;
                    height: 450px;
                    border-radius: 50%;
                    background: #6366f1;
                    filter: blur(150px);
                    opacity: .28;
                    bottom: -180px;
                    right: -150px;
                }

            .brand {
                display: flex;
                align-items: center;
                gap: 12px;
                font-size: 25px;
                font-weight: 800;
                letter-spacing: -1px;
                z-index: 1;
            }

            .brand-icon {
                width: 44px;
                height: 44px;
                border-radius: 14px;
                background: linear-gradient(135deg, #818cf8, #6366f1);
                display: flex;
                justify-content: center;
                align-items: center;
                font-size: 23px;
            }

            .brand span {
                color: #a5b4fc;
            }

            .left-content {
                position: relative;
                z-index: 1;
                max-width: 500px;
            }

            .left-badge {
                display: inline-block;
                padding: 9px 16px;
                border: 1px solid rgba(255,255,255,.15);
                background: rgba(255,255,255,.07);
                color: #c7d2fe;
                border-radius: 30px;
                font-size: 12px;
                font-weight: 600;
                margin-bottom: 25px;
            }

            .left-content h1 {
                font-size: clamp(32px, 3.5vw, 49px);
                line-height: 1.16;
                font-weight: 800;
                letter-spacing: -2px;
                margin-bottom: 22px;
            }

                .left-content h1 span {
                    color: #a5b4fc;
                }

            .left-content p {
                font-size: 15px;
                line-height: 1.9;
                color: #aeb9d4;
                max-width: 400px;
            }

            /* ÖRNEK E-POSTA KARTI */

            .mail-preview {
                margin-top: 45px;
                padding: 22px;
                background: rgba(255,255,255,.09);
                border: 1px solid rgba(255,255,255,.13);
                border-radius: 20px;
                backdrop-filter: blur(12px);
                box-shadow: 0 25px 55px rgba(0,0,0,.15);
            }

            .preview-title {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 18px;
                font-size: 14px;
                font-weight: 700;
            }

            .preview-count {
                background: #6366f1;
                border-radius: 20px;
                padding: 5px 10px;
                font-size: 11px;
            }

            .preview-message {
                display: flex;
                align-items: center;
                gap: 13px;
                padding: 14px;
                background: rgba(255,255,255,.09);
                border-radius: 12px;
                margin-bottom: 10px;
            }

                .preview-message:last-child {
                    margin-bottom: 0;
                }

            .avatar {
                width: 40px;
                height: 40px;
                flex-shrink: 0;
                border-radius: 12px;
                display: flex;
                justify-content: center;
                align-items: center;
                font-size: 13px;
                font-weight: 700;
            }

            .avatar-one {
                background: #b8e6db;
                color: #166653;
            }

            .avatar-two {
                background: #f9d8b3;
                color: #98551d;
            }

            .preview-message strong {
                display: block;
                font-size: 12px;
                margin-bottom: 5px;
            }

            .preview-message small {
                display: block;
                font-size: 11px;
                color: #b9c2d9;
            }

            .left-footer {
                z-index: 1;
                font-size: 12px;
                color: #8793b4;
            }

            /* SAĞ KAYIT FORMU */

            .auth-right {
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 55px 45px;
                background: #ffffff;
            }

            .form-wrapper {
                width: 100%;
                max-width: 480px;
            }

            .form-label-top {
                display: inline-block;
                color: var(--primary);
                font-size: 12px;
                font-weight: 700;
                letter-spacing: 1.4px;
                margin-bottom: 16px;
            }

            .form-wrapper h2 {
                font-size: 32px;
                font-weight: 800;
                letter-spacing: -1.3px;
                margin-bottom: 12px;
            }

            .form-description {
                color: var(--muted);
                font-size: 14px;
                line-height: 1.8;
                margin-bottom: 34px;
            }

            .form-row {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 16px;
            }

            .form-group {
                margin-bottom: 20px;
            }

                .form-group label {
                    display: block;
                    font-size: 13px;
                    font-weight: 600;
                    color: #38445c;
                    margin-bottom: 9px;
                }

            .form-control {
                width: 100%;
                height: 49px;
                border: 1px solid var(--border);
                border-radius: 11px;
                padding: 0 15px;
                background: #fafbfe;
                color: var(--text);
                font-family: inherit;
                font-size: 13px;
                outline: none;
                transition: all .2s ease;
            }

                .form-control::placeholder {
                    color: #a3adbd;
                }

                .form-control:focus {
                    border-color: var(--primary);
                    background: white;
                    box-shadow: 0 0 0 4px rgba(99,102,241,.09);
                }

                .form-control.input-validation-error {
                    border-color: #ef4444;
                }

            .password-wrapper {
                position: relative;
            }

                .password-wrapper .form-control {
                    padding-right: 82px;
                }

            .password-toggle {
                position: absolute;
                top: 50%;
                right: 13px;
                transform: translateY(-50%);
                background: transparent;
                border: none;
                color: #777f94;
                cursor: pointer;
                font-family: inherit;
                font-size: 12px;
                font-weight: 600;
                padding: 8px;
            }

                .password-toggle:hover {
                    color: var(--primary);
                }

            .password-hint {
                display: block;
                margin-top: 8px;
                font-size: 11px;
                line-height: 1.6;
                color: #929bae;
            }

            .validation-summary-errors {
                border: 1px solid #fecaca;
                background: #fff1f2;
                border-radius: 10px;
                padding: 13px 17px;
                color: #dc2626;
                font-size: 12px;
                margin-bottom: 20px;
            }

                .validation-summary-errors ul {
                    padding-left: 15px;
                    margin: 0;
                }

            .field-validation-error {
                display: block;
                color: #dc2626;
                font-size: 11px;
                margin-top: 7px;
            }

            .register-btn {
                width: 100%;
                height: 52px;
                border: none;
                border-radius: 12px;
                background: linear-gradient( 135deg, #6366f1, #4f46e5 );
                color: white;
                font-family: inherit;
                font-size: 14px;
                font-weight: 700;
                cursor: pointer;
                margin-top: 8px;
                transition: all .2s ease;
                box-shadow: 0 8px 20px rgba(99,102,241,.2);
            }

                .register-btn:hover {
                    background: linear-gradient( 135deg, #5558e9, #4338ca );
                    transform: translateY(-1px);
                    box-shadow: 0 12px 25px rgba(99,102,241,.28);
                }

                .register-btn:active {
                    transform: translateY(0);
                }

            .login-link {
                text-align: center;
                margin-top: 28px;
                color: var(--muted);
                font-size: 13px;
            }

                .login-link a {
                    color: var(--primary);
                    text-decoration: none;
                    font-weight: 700;
                    margin-left: 5px;
                }

                    .login-link a:hover {
                        text-decoration: underline;
                    }

            .form-footer {
                text-align: center;
                margin-top: 42px;
                font-size: 11px;
                color: #a8b0bf;
            }

            /* MOBİL UYUM */

            @@media (max-width: 1100px) {
                .auth-left {
                    padding: 45px 35px;
                }

                .auth-right {
                    padding: 40px 30px;
                }
            }

            @@media (max-width: 850px) {
                .auth-container {
                    grid-template-columns: 1fr;
                }

                .auth-left {
                    display: none;
                }

                .auth-right {
                    min-height: 100vh;
                    padding: 45px 25px;
                }
            }

            @@media (max-width: 480px) {
                .form-row {
                    grid-template-columns: 1fr;
                    gap: 0;
                }

                .form-wrapper h2 {
                    font-size: 28px;
                }

                .auth-right {
                    padding: 35px 20px;
                }
            }
    </style>
</head>

<body>

    <main class="auth-container">

        <!-- SOL PANEL -->

        <section class="auth-left">

           
            <div class="brand">
                <div class="brand-icon">✉</div>
                <div class="brand-name">Nex<span>ora</span></div>
            </div>


            <div class="left-content">

                <div class="left-badge">
                    ✦ YENİ NESİL MESAJLAŞMA
                </div>

                <h1>
                    Mesajların için
                    <span>yeni bir dünya.</span>
                </h1>

                <p>
                    Modern, hızlı ve güvenli mesajlaşma deneyimi.
                    Tüm iletişimini tek bir yerde yönet,
                    bağlantıda kal ve hiçbir mesajı kaçırma.
                </p>

                <div class="mail-preview">

                    <div class="preview-title">
                        <span>Gelen Kutusu</span>
                        <span class="preview-count">2 Yeni</span>
                    </div>

                    <div class="preview-message">

                        <div class="avatar avatar-one">AY</div>

                        <div>
                            <strong>Ayşe Yılmaz</strong>
                            <small>Merhaba! Yeni projeyi inceledim...</small>
                        </div>

                    </div>

                    <div class="preview-message">

                        <div class="avatar avatar-two">MK</div>

                        <div>
                            <strong>Mehmet Kaya</strong>
                            <small>Toplantı detaylarını paylaştım.</small>
                        </div>

                    </div>

                </div>

            </div>

            <div class="left-footer">
                © @DateTime.Now.Year Nexora. Tüm hakları saklıdır.
            </div>

        </section>


        <!-- SAĞ PANEL -->

        <section class="auth-right">

            <div class="form-wrapper">

                <span class="form-label-top">
                    NEXORA'YA HOŞ GELDİN
                </span>

                <h2>Hesabını oluştur.</h2>

                <p class="form-description">
                    Hemen ücretsiz hesabını oluştur ve
                    modern mesajlaşma deneyimine katıl.
                </p>


                <form asp-controller="Auth"
                      asp-action="Register"
                      method="post">

                    <!-- AD SOYAD -->

                    <div class="form-row">

                        <div class="form-group">

                            <label asp-for="FirstName">
                                Ad
                            </label>

                            <input asp-for="FirstName"
                                   class="form-control"
                                   placeholder="Adın"
                                   autocomplete="given-name"
                                   required />

                            <span asp-validation-for="FirstName"></span>

                        </div>

                        <div class="form-group">

                            <label asp-for="LastName">
                                Soyad
                            </label>

                            <input asp-for="LastName"
                                   class="form-control"
                                   placeholder="Soyadın"
                                   autocomplete="family-name"
                                   required />

                            <span asp-validation-for="LastName"></span>

                        </div>

                    </div>


                    <!-- EMAIL -->

                    <div class="form-group">

                        <label asp-for="Email">
                            E-posta Adresi
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               placeholder="ornek@email.com"
                               autocomplete="email"
                               required />

                        <span asp-validation-for="Email"></span>

                    </div>


                    <!-- KULLANICI ADI -->

                    <div class="form-group">

                        <label asp-for="UserName">
                            Kullanıcı Adı
                        </label>

                        <input asp-for="UserName"
                               class="form-control"
                               placeholder="Kullanıcı adını belirle"
                               autocomplete="username"
                               required />

                        <span asp-validation-for="UserName"></span>

                    </div>


                    <!-- ŞİFRE -->

                    <div class="form-group">

                        <label asp-for="Password">
                            Şifre
                        </label>

                        <div class="password-wrapper">

                            <input asp-for="Password"
                                   type="password"
                                   class="form-control"
                                   placeholder="Şifreni oluştur"
                                   autocomplete="new-password"
                                   required />

                            <button type="button"
                                    class="password-toggle"
                                    data-password-toggle="Password"
                                    aria-label="Şifreyi göster"
                                    aria-pressed="false">
                                Göster
                            </button>

                        </div>

                        <span asp-validation-for="Password"></span>

                        <small class="password-hint">
                            Güvenliğin için güçlü bir şifre oluştur.
                        </small>

                    </div>


                    <!-- ŞİFRE TEKRAR -->

                    <div class="form-group">

                        <label asp-for="ConfirmPassword">
                            Şifre Tekrar
                        </label>

                        <div class="password-wrapper">

                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   class="form-control"
                                   placeholder="Şifreni tekrar gir"
                                   autocomplete="new-password"
                                   required />

                            <button type="button"
                                    class="password-toggle"
                                    data-password-toggle="ConfirmPassword"
                                    aria-label="Şifre tekrarını göster"
                                    aria-pressed="false">
                                Göster
                            </button>

                        </div>

                        <span asp-validation-for="ConfirmPassword"></span>

                    </div>


                    <!-- HATALAR -->

                    <div asp-validation-summary="All"></div>


                    <!-- KAYIT BUTONU -->

                    <button type="submit" class="register-btn">
                        Hesap Oluştur &rarr;
                    </button>

                </form>


                <!-- GİRİŞ YAP -->

                <div class="login-link">

                    Zaten hesabın var mı?

                    <a asp-controller="Auth"
                           asp-action="Login">
                        Giriş Yap
                    </a>

                </div>


                <div class="form-footer">
                    © @DateTime.Now.Year Nexora
                    · Güvenli ve modern iletişim
                </div>

            </div>

        </section>

    </main>


    <script>
            document.querySelectorAll("[data-password-toggle]")
                .forEach(function (button) {

                    button.addEventListener("click", function () {

                        const inputId = button.getAttribute("data-password-toggle");
                        const input = document.getElementById(inputId);

                        if (!input) return;

                        const isVisible = input.type === "text";

                        input.type = isVisible ? "password" : "text";

                        button.textContent = isVisible ? "Göster" : "Gizle";

                        button.setAttribute(
                            "aria-pressed",
                            String(!isVisible)
                        );

                        button.setAttribute(
                            "aria-label",
                            isVisible ? "Şifreyi göster" : "Şifreyi gizle"
                        );

                    });

                });
    </script>

</body>
</html>

