@model IdentityMail.Web.DTOs.UserDtos.ForgotPasswordDto

@{
    ViewData["Title"] = "Şifremi Unuttum";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Şifremi Unuttum - Nexora</title>

    <style>
            body {
                margin: 0;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #101014;
                color: #fff;
                font-family: Arial, sans-serif;
            }

            .card {
                width: 380px;
                max-width: calc(100% - 60px);
                padding: 30px;
                background: #1a1a20;
                border: 1px solid #303039;
                border-radius: 14px;
            }

            h1 {
                color: #a78bfa;
                text-align: center;
            }

            h2 {
                font-size: 22px;
                margin-top: 25px;
            }

            p {
                color: #aaa;
                font-size: 13px;
                line-height: 1.6;
            }

            label {
                display: block;
                margin: 20px 0 8px;
                font-size: 13px;
            }

            input {
                box-sizing: border-box;
                width: 100%;
                padding: 13px;
                background: #25252d;
                border: 1px solid #454552;
                border-radius: 8px;
                color: white;
            }

            button {
                width: 100%;
                padding: 13px;
                margin-top: 20px;
                background: #6d48ba;
                border: none;
                border-radius: 8px;
                color: white;
                cursor: pointer;
            }

                button:hover {
                    background: #8055d6;
                }

            .back {
                display: block;
                margin-top: 20px;
                text-align: center;
                color: #a78bfa;
                text-decoration: none;
                font-size: 13px;
            }

            .message {
                margin-top: 15px;
                padding: 12px;
                background: #302547;
                color: #d6c6ff;
                border-radius: 8px;
                font-size: 13px;
            }

            .error {
                color: #f87171;
                font-size: 12px;
            }
    </style>
</head>

<body>

    <div class="card">

        <h1>Nexora.</h1>

        <h2>Şifremi Unuttum</h2>

        <p>
            Şifre sıfırlama talebiniz için
            e-posta adresinizi giriniz.
        </p>

        @if (ViewBag.Message != null)
        {
            <div class="message">
                @ViewBag.Message
            </div>
        }

        <form asp-controller="Auth"
              asp-action="ForgotPassword"
              method="post">

            @Html.AntiForgeryToken()

            <label asp-for="Email">
                E-posta Adresi
            </label>

            <input asp-for="Email"
                   type="email"
                   placeholder="ornek@gmail.com" />

            <span asp-validation-for="Email"
                  class="error">
            </span>

            <button type="submit">
                Devam Et
            </button>

        </form>

        <a asp-controller="Auth"
           asp-action="Login"
           class="back">

            ← Giriş Ekranına Dön

        </a>

    </div>

</body>
</html>
