@using IdentityMail.Web.Entities
@model List<MailCategory>

@{
    ViewData["Title"] = "Kategoriler";
    Layout = "_NexoraLayout";
}

<section class="nexora-inbox nx-categories-page">

    <!-- BAŞLIK -->
    <div class="inbox-heading">

        <div>
            <span class="inbox-eyebrow">
                NEXORA MAIL / KATEGORİLER
            </span>

            <h1>Kategoriler</h1>

            <p>
                Mesajlarını kategorilere ayırarak düzenle.
            </p>
        </div>

        <div class="inbox-summary">
            @Model.Count kategori
        </div>

    </div>


    <!-- HATA MESAJI -->
    @if (TempData["CategoryError"] != null)
    {
        <div class="nx-category-error">
            @TempData["CategoryError"]
        </div>
    }


    <!-- KATEGORİ OLUŞTURMA -->
    <div class="nx-category-panel">

        <h2>Yeni Kategori Oluştur</h2>

        <form asp-controller="Category"
              asp-action="Create"
              method="post"
              asp-antiforgery="true"
              class="nx-category-form">

            <input type="text"
                   name="name"
                   placeholder="Kategori adı (Örn: İş)"
                   maxlength="50"
                   required
                   class="nx-category-input" />

            <input type="color"
                   name="color"
                   value="#8b5cf6"
                   title="Kategori rengi"
                   class="nx-category-color" />

            <button type="submit"
                    class="nx-category-create">

                + Kategori Oluştur

            </button>

        </form>

    </div>


    <!-- KATEGORİ LİSTESİ -->
    <div class="nx-category-panel">

        <h2>Kategorilerim</h2>

        @if (Model.Count == 0)
        {
            <div class="nx-category-empty">
                Henüz kategori oluşturmadın.
            </div>
        }
        else
        {
            <div class="nx-category-grid">

                @foreach (var item in Model)
                {
                    var categoryName = item.Name;

                    // Önceden yazılmış KATEGORİ : ifadesini
                    // sadece ekranda gizliyoruz.
                    if (categoryName.StartsWith(
                        "KATEGORİ :",
                        StringComparison.OrdinalIgnoreCase))
                    {
                        categoryName = categoryName
                            .Substring("KATEGORİ :".Length)
                            .Trim();
                    }

                    <div class="nx-category-card">

                        <a asp-controller="Category"
                           asp-action="Messages"
                           asp-route-id="@item.Id"
                           class="nx-category-link">

                            <div class="nx-category-top">

                                <span class="nx-category-dot"
                                      style="background-color:@item.Color">
                                </span>

                                <strong>@categoryName</strong>

                            </div>

                            <span class="nx-category-view">
                                Mesajları Gör →
                            </span>

                        </a>


                        <form asp-controller="Category"
                              asp-action="Delete"
                              asp-route-id="@item.Id"
                              asp-antiforgery="true"
                              method="post"
                              onsubmit="return confirm('Kategori silinsin mi?');">

                            <button type="submit"
                                    class="nx-category-delete"
                                    title="Kategoriyi sil">

                                🗑

                            </button>

                        </form>

                    </div>
                }

            </div>
        }

    </div>

</section>


<style>

    /* SAYFA HİZALAMA */
    .nx-categories-page {
        width: 100%;
        max-width: none;
        margin: 0;
        box-sizing: border-box;
    }

        .nx-categories-page * {
            box-sizing: border-box;
        }


    /* PANELLER */
    .nx-category-panel {
        width: 100%;
        padding: 24px;
        margin-bottom: 20px;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        background: #ffffff;
    }

        .nx-category-panel h2 {
            margin: 0 0 20px;
            font-size: 17px;
            font-weight: 700;
        }


    /* KATEGORİ OLUŞTURMA FORMU */
    .nx-category-form {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .nx-category-input {
        flex: 1;
        min-width: 180px;
        padding: 13px;
        border: 1px solid #d1d5db;
        border-radius: 9px;
        background: transparent;
        color: inherit;
        font: inherit;
    }

    .nx-category-color {
        width: 48px;
        height: 46px;
        padding: 4px;
        border: 1px solid #d1d5db;
        border-radius: 9px;
        cursor: pointer;
    }

    .nx-category-create {
        padding: 13px 18px;
        border: none;
        border-radius: 9px;
        background: #635bff;
        color: white;
        font-weight: 600;
        cursor: pointer;
    }

        .nx-category-create:hover {
            background: #5148e8;
        }


    /* KATEGORİ KARTLARI */
    .nx-category-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 260px));
        justify-content: center;
        gap: 14px;
    }

    .nx-category-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        min-width: 0;
        min-height: 100px;
        padding: 16px;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        background: #fafbff;
    }

        .nx-category-card:hover {
            border-color: #8b5cf6;
        }


    /* KATEGORİ İÇERİĞİ */
    .nx-category-link {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 12px;
        flex: 1;
        min-width: 0;
        color: inherit;
        text-decoration: none;
    }

    .nx-category-top {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
    }

        .nx-category-top strong {
            font-size: 14px;
            font-weight: 600;
            overflow-wrap: anywhere;
        }

    .nx-category-dot {
        width: 10px;
        height: 10px;
        flex-shrink: 0;
        border-radius: 50%;
    }

    .nx-category-view {
        color: #8b5cf6;
        font-size: 12px;
        font-weight: 600;
    }

    .nx-category-link:hover .nx-category-view {
        text-decoration: underline;
    }


    /* SİLME BUTONU */
    .nx-category-delete {
        border: none;
        border-radius: 7px;
        background: transparent;
        padding: 8px;
        cursor: pointer;
        font-size: 16px;
    }

        .nx-category-delete:hover {
            background: rgba(239, 68, 68, 0.12);
        }


    /* HATA VE BOŞ LİSTE */
    .nx-category-error {
        margin-bottom: 16px;
        padding: 12px 16px;
        border-radius: 9px;
        background: #fff1f2;
        color: #be123c;
    }

    .nx-category-empty {
        padding: 30px;
        text-align: center;
        color: #64748b;
    }


    /* KOYU TEMA */
    html[data-theme="dark"] .nx-category-panel {
        background: #171717;
        border-color: #303030;
    }

    html[data-theme="dark"] .nx-category-card {
        background: #202020;
        border-color: #383838;
    }

        html[data-theme="dark"] .nx-category-card:hover {
            border-color: #8b5cf6;
        }

    html[data-theme="dark"] .nx-category-input {
        color: #f5f5f5;
        border-color: #444444;
    }

    html[data-theme="dark"] .nx-category-link {
        color: #f5f5f5;
    }


    /* MOBİL */
    @@media (max-width: 600px) {

        .nx-category-panel {
            padding: 16px;
        }

        .nx-category-grid {
            grid-template-columns: 1fr;
        }

        .nx-category-create {
            width: 100%;
        }
    }

</style>
