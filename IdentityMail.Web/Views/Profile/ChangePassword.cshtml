@model IdentityMail.Web.DTOs.ChangePasswordDto

@{
    ViewData["Title"] = "Şifre Değiştir";
    Layout = "_NexoraLayout";
}

<div class="nx-password-page">

    <div class="nx-password-card">

        <h2>Şifre Değiştir</h2>

        <p>
            Hesabınızın şifresini buradan güncelleyebilirsiniz.
        </p>

        <form action="@Url.Action("ChangePassword", "Profile", new { area = "" })"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All"
                 class="text-danger mb-3">
            </div>


            <!-- MEVCUT ŞİFRE -->
            <div class="mb-3">

                <label asp-for="CurrentPassword"
                       class="form-label">
                    Mevcut Şifre
                </label>

                <input asp-for="CurrentPassword"
                       type="password"
                       autocomplete="current-password"
                       class="form-control" />

            </div>


            <!-- YENİ ŞİFRE -->
            <div class="mb-3">

                <label asp-for="NewPassword"
                       class="form-label">
                    Yeni Şifre
                </label>

                <input asp-for="NewPassword"
                       type="password"
                       autocomplete="new-password"
                       class="form-control" />

            </div>


            <!-- YENİ ŞİFRE TEKRAR -->
            <div class="mb-4">

                <label asp-for="ConfirmPassword"
                       class="form-label">
                    Yeni Şifre Tekrar
                </label>

                <input asp-for="ConfirmPassword"
                       type="password"
                       autocomplete="new-password"
                       class="form-control" />

            </div>


            <!-- BUTONLAR -->
            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn nx-password-button">

                    Şifremi Güncelle

                </button>

                <a href="@Url.Action("Index", "Profile", new { area = "" })"
                   class="btn btn-secondary">

                    Vazgeç

                </a>

            </div>

        </form>

    </div>

</div>


<style>
    .nx-password-page {
        max-width: 650px;
        margin: 40px auto;
        padding: 20px;
    }

    .nx-password-card {
        background: #ffffff;
        color: #18181b;
        border: 1px solid #e4e4eb;
        border-radius: 14px;
        padding: 30px;
    }

        .nx-password-card h2 {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 12px;
        }

        .nx-password-card p {
            color: #888;
            font-size: 13px;
            margin-bottom: 25px;
        }

    .nx-password-button {
        background: #6d48ba;
        color: white;
    }

        .nx-password-button:hover {
            background: #8055d6;
            color: white;
        }

    html[data-theme="dark"] .nx-password-card {
        background: #1a1a20;
        color: #f5f5f5;
        border-color: #303039;
    }

        html[data-theme="dark"] .nx-password-card .form-control {
            background: #25252d;
            color: white;
            border-color: #454552;
        }
</style>
