@using IdentityMail.Web.Entities
@model List<AppUser>

@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    
    var userRoles = ViewBag.UserRoles as Dictionary<int, string>
                    ?? new Dictionary<int, string>();

}

<section class="nx-users-page">

    
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- SAYFA BAŞLIĞI -->
    <div class="nx-users-header">

        <div>
            <span class="nx-users-eyebrow">
                NEXORA / ADMIN PANEL
            </span>

            <h1>Kullanıcı Yönetimi</h1>

            <p>
                Sisteme kayıtlı kullanıcıları
                buradan görüntüleyebilirsin.
            </p>
        </div>

        <div class="nx-users-count">
            @Model.Count kullanıcı
        </div>

    </div>


    <!-- KULLANICI TABLOSU -->
    <div class="nx-users-panel">

        <div class="nx-users-panel-header">
            <h2>Kayıtlı Kullanıcılar</h2>
            <span>Toplam @Model.Count hesap</span>
        </div>

        @if (Model.Count == 0)
        {
            <div class="nx-users-empty">
                Henüz kayıtlı kullanıcı bulunmuyor.
            </div>
        }
        else
        {
            <div class="nx-users-table-wrap">

                <table class="nx-users-table">

                    <thead>
                        <tr>
                            <th>Kullanıcı</th>
                            <th>E-posta Adresi</th>
                            <th>Kullanıcı Adı</th>
                            <th>Rol</th>
                            <th>Giriş Kilidi</th>
                            <th>İşlem</th>
                            <th>Hesap İşlemi</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            var firstName = item.FirstName ?? "";
                            var lastName = item.LastName ?? "";

                            var fullName =
                                $"{firstName} {lastName}".Trim();

                            if (string.IsNullOrWhiteSpace(fullName))
                            {
                                fullName = "İsimsiz Kullanıcı";
                            }

                            var initials =
                                (firstName.Length > 0 ? firstName[..1] : "") +
                                (lastName.Length > 0 ? lastName[..1] : "");

                            if (string.IsNullOrWhiteSpace(initials))
                            {
                                initials = "?";
                            }

                            <tr>

                                <!-- KULLANICI -->
                                <td>
                                    <div class="nx-user-info">

                                        <div class="nx-user-avatar">
                                            @initials.ToUpperInvariant()
                                        </div>

                                       
                                       
                                        <a href="@Url.Action("Details", "Users", new { area = "Admin", id = item.Id })"
                                           style="color: #c4b5fd; text-decoration: none; font-weight: 600;">
                                            @fullName
                                        </a>



                                    </div>
                                </td>

                                <!-- E-POSTA -->
                                <td>
                                    @item.Email
                                </td>

                                <!-- KULLANICI ADI -->
                                <td>
                                    @item.UserName
                                </td>

                                
                                <!-- KULLANICI ROLÜ -->
                                <td>
                                    @{
                                        var roleName = userRoles.TryGetValue(item.Id, out var role)
                                            ? role
                                            : "Standart Kullanıcı";
                                    }

                                    <span class="nx-user-role @(roleName.Contains("Admin") ? "is-admin" : "")">
                                        @roleName
                                    </span>
                                </td>

                                <!-- HESAP DURUMU -->
                                <td>
                                    @{
                                        var isPassive =
                                            item.LockoutEnabled &&
                                            item.LockoutEnd == DateTimeOffset.MaxValue;

                                        var isLocked =
                                            item.LockoutEnabled &&
                                            item.LockoutEnd.HasValue &&
                                            item.LockoutEnd.Value > DateTimeOffset.UtcNow;
                                    }

                                    @if (isPassive)
                                    {
                                        <span class="nx-user-status is-locked">
                                            Pasif
                                        </span>
                                    }
                                    else if (isLocked)
                                    {
                                        <span class="nx-user-status is-locked">
                                            Kilitli
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="nx-user-status">
                                            Aktif
                                        </span>
                                    }
                                </td>


                                <!-- ROL DEĞİŞTİRME -->
                                <td>
                                    @{
                                        var currentUserId = User.FindFirst(
                                            System.Security.Claims.ClaimTypes.NameIdentifier
                                        )?.Value;

                                        var isOwnAccount =
                                            currentUserId == item.Id.ToString();

                                        var isAdmin = roleName
                                            .Split(',', StringSplitOptions.TrimEntries)
                                            .Contains("Admin");
                                    }

                                    @if (isOwnAccount)
                                    {
                                        <span class="nx-role-own-account">
                                            Kendi hesabın
                                        </span>
                                    }
                                    else
                                    {
                                        <form action="@Url.Action("ChangeRole", "Users", new { area = "Admin" })"
                                              method="post"
                                              class="nx-role-form">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.Id" />

                                            <select name="role"
                                                    class="nx-role-select"
                                                    aria-label="Kullanıcı rolü">

                                                <option value="User"
                                                        selected="@(!isAdmin)">
                                                    User
                                                </option>

                                                <option value="Admin"
                                                        selected="@isAdmin">
                                                    Admin
                                                </option>

                                            </select>

                                            <button type="submit"
                                                    class="nx-role-save">
                                                Güncelle
                                            </button>

                                        </form>
                                    }
                                </td>

                                <!-- HESAP AKTİF / PASİF İŞLEMİ -->
                                <td>
                                    @if (isOwnAccount || isAdmin)
                                    {
                                        <span class="nx-role-own-account">
                                            Değiştirilemez
                                        </span>
                                    }
                                    else
                                    {
                                        <form action="@Url.Action("ChangeStatus", "Users", new { area = "Admin" })"
                                              method="post"
                                              class="nx-status-form">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.Id" />

                                            <input type="hidden"
                                                   name="isActive"
                                                   value="@(isPassive ? "true" : "false")" />

                                            <button type="submit"
                                                    class="nx-status-button @(isPassive ? "activate" : "deactivate")"
                                                    onclick="return confirm('Kullanıcının hesap durumunu değiştirmek istiyor musunuz?');">

                                                @(isPassive ? "Aktif Et" : "Pasife Al")

                                            </button>

                                        </form>
                                    }
                                </td>


                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</section>

<style>
    .nx-users-page {
        max-width: 1450px;
        margin: 0 auto;
        padding: 30px;
    }

    .nx-users-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .nx-users-eyebrow {
        display: block;
        color: #a78bfa;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.2px;
        margin-bottom: 10px;
    }

    .nx-users-header h1 {
        margin: 0;
        color: #f5f5f5;
        font-size: 28px;
        font-weight: 800;
    }

    .nx-users-header p {
        color: #a1a1aa;
        font-size: 13px;
        margin-top: 10px;
    }

    .nx-users-count {
        padding: 12px 16px;
        background: #27213c;
        border: 1px solid #44365f;
        border-radius: 10px;
        color: #c4b5fd;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .nx-users-panel {
        background: #19191f;
        border: 1px solid #303039;
        border-radius: 14px;
        overflow: hidden;
    }

    .nx-users-panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 22px;
        border-bottom: 1px solid #303039;
    }

        .nx-users-panel-header h2 {
            margin: 0;
            font-size: 17px;
            color: #f5f5f5;
        }

        .nx-users-panel-header span {
            color: #a1a1aa;
            font-size: 12px;
        }

    .nx-users-table-wrap {
        overflow-x: auto;
    }

    .nx-users-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
    }

        .nx-users-table th {
            padding: 17px 20px;
            background: #202027;
            color: #a1a1aa;
            font-size: 12px;
            font-weight: 600;
        }

        .nx-users-table td {
            padding: 18px 20px;
            color: #d4d4d8;
            font-size: 13px;
            border-top: 1px solid #303039;
        }

        .nx-users-table tbody tr:hover {
            background: #23232c;
        }

    .nx-user-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .nx-user-info strong {
            color: #f5f5f5;
            font-size: 13px;
            white-space: nowrap;
        }

    .nx-user-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 38px;
        height: 38px;
        border-radius: 50%;
        background: #302c50;
        color: #c4b5fd;
        font-weight: 700;
        font-size: 12px;
    }

    .nx-users-empty {
        padding: 50px;
        text-align: center;
        color: #a1a1aa;
    }

    @@media (max-width: 700px) {
        .nx-users-page {
            padding: 16px;
        }

        .nx-users-header {
            align-items: flex-start;
        }

        .nx-users-table {
            min-width: 680px;
        }
    }
    
    /* KULLANICI ROLLERİ */

    .nx-user-role {
        display: inline-block;
        padding: 7px 11px;
        border-radius: 7px;
        background: #303038;
        color: #d4d4d8;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
    }

        .nx-user-role.is-admin {
            background: #302547;
            color: #c4b5fd;
        }

        
    /* GİRİŞ KİLİDİ DURUMU */

    .nx-user-status {
        display: inline-block;
        padding: 7px 11px;
        border-radius: 7px;
        background: #19372b;
        color: #86efac;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
    }

        .nx-user-status.is-locked {
            background: #492526;
            color: #fca5a5;
        }

        
    /* ROL DEĞİŞTİRME FORMU */

    .nx-role-form {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0;
    }

    .nx-role-select {
        padding: 9px 11px;
        background: #252530;
        border: 1px solid #454552;
        border-radius: 8px;
        color: #f5f5f5;
        font-size: 12px;
        cursor: pointer;
    }

    .nx-role-save {
        padding: 9px 13px;
        background: #6d48ba;
        border: none;
        border-radius: 8px;
        color: white;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
    }

        .nx-role-save:hover {
            background: #8055d6;
        }

    .nx-role-own-account {
        color: #a1a1aa;
        font-size: 12px;
        white-space: nowrap;
    }
    /* HESAP AKTİF / PASİF İŞLEMLERİ */

    .nx-status-form {
        margin: 0;
    }

    .nx-status-button {
        padding: 9px 13px;
        border: none;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
    }

        .nx-status-button.deactivate {
            background: #492526;
            color: #fca5a5;
        }

        .nx-status-button.activate {
            background: #19372b;
            color: #86efac;
        }

        .nx-status-button.deactivate:hover {
            background: #653033;
        }

        .nx-status-button.activate:hover {
            background: #25513c;
        }

</style>
