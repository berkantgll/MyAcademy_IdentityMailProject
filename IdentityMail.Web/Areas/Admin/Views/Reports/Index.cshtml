@using IdentityMail.Web.Entities
@model List<MessageReport>

@{
    ViewData["Title"] = "Mesaj Şikâyetleri";

    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var totalReports = Model.Count;

    var pendingReports = Model.Count(x => !x.IsReviewed);

    var reviewedReports = Model.Count(x => x.IsReviewed);
}

<section class="nx-reports-page">

    <!-- SAYFA BAŞLIĞI -->
    <div class="nx-reports-header">

        <div>
            <span class="nx-reports-eyebrow">
                NEXORA / ADMIN PANEL
            </span>

            <h1>Mesaj Şikâyetleri</h1>

            <p>
                Kullanıcılardan gelen mesaj şikâyetlerini
                buradan takip edebilirsin.
            </p>
        </div>

        <div class="nx-reports-icon">
            ⚑
        </div>

    </div>


    <!-- İSTATİSTİK KARTLARI -->
    <div class="nx-reports-stats">

        <!-- TOPLAM ŞİKAYET -->
        <div class="nx-reports-stat-card">

            <span>Toplam Şikâyet</span>

            <strong>@totalReports</strong>

            <small>Tüm şikâyet kayıtları</small>

        </div>


        <!-- BEKLEYEN -->
        <div class="nx-reports-stat-card">

            <span>Bekleyen Şikâyet</span>

            <strong class="nx-report-yellow">
                @pendingReports
            </strong>

            <small>Henüz incelenmemiş</small>

        </div>


        <!-- İNCELENEN -->
        <div class="nx-reports-stat-card">

            <span>İncelenen Şikâyet</span>

            <strong class="nx-report-green">
                @reviewedReports
            </strong>

            <small>İncelemesi tamamlanan</small>

        </div>

    </div>


    <!-- ŞİKAYET TABLOSU -->
    <div class="nx-reports-panel">

        <div class="nx-reports-panel-header">

            <div>
                <h2>Şikâyet Kayıtları</h2>

                <p>
                    İncelenmeyi bekleyen şikâyetler
                    önce gösterilir.
                </p>
            </div>

            <span>
                @totalReports kayıt
            </span>

        </div>


        @if (Model.Count == 0)
        {
            <!-- BOŞ LİSTE -->
            <div class="nx-reports-empty">

                <div class="nx-reports-empty-icon">
                    ✓
                </div>

                <h3>Henüz şikâyet bulunmuyor</h3>

                <p>
                    Kullanıcılardan yeni şikâyet geldiğinde
                    burada listelenecek.
                </p>

            </div>
        }
        else
        {
            <!-- ŞİKAYETLER -->
            <div class="nx-reports-table-wrap">

                <table class="nx-reports-table">

                    <thead>
                        <tr>
                            <th>Şikâyet No</th>
                            <th>Mesaj No</th>
                            <th>Şikâyet Eden ID</th>
                            <th>Şikâyet Nedeni</th>
                            <th>Tarih</th>
                            <th>Durum</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var report in Model)
                        {
                            <tr>

                               
                                <!-- ŞİKAYET DETAY BAĞLANTISI -->
                                <td>
                                    <a href="@Url.Action("Details", "Reports", new { area = "Admin", id = report.Id })"
                                       class="nx-report-id">

                                        #@report.Id

                                    </a>
                                </td>



                                <!-- MESAJ ID -->
                                <td>
                                    #@report.UserMessageId
                                </td>


                                <!-- ŞİKAYET EDEN -->
                                <td>
                                    #@report.ReporterId
                                </td>


                                <!-- ŞİKAYET NEDENİ -->
                                <td>
                                    <span class="nx-report-reason">
                                        @report.Reason
                                    </span>
                                </td>


                                <!-- TARİH -->
                                <td>
                                    <span class="nx-report-date">
                                        @report.ReportedAt.ToString("dd.MM.yyyy HH:mm") UTC
                                    </span>
                                </td>


                                <!-- DURUM -->
                                <td>

                                    @if (report.IsReviewed)
                                    {
                                        <span class="nx-report-status reviewed">
                                            ✓ İncelendi
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="nx-report-status pending">
                                            ● Bekliyor
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>


    <!-- DASHBOARD'A DÖN -->
    <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })"
       class="nx-reports-back">

        ← Dashboard'a Dön

    </a>

</section>


<style>

    /* ANA SAYFA */
    .nx-reports-page {
        max-width: 1450px;
        margin: 0 auto;
        padding: 30px;
    }


    /* SAYFA BAŞLIĞI */
    .nx-reports-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .nx-reports-eyebrow {
        display: block;
        color: #a78bfa;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.3px;
        margin-bottom: 10px;
    }

    .nx-reports-header h1 {
        margin: 0;
        color: #f5f5f5;
        font-size: 29px;
        font-weight: 800;
    }

    .nx-reports-header p {
        color: #a1a1aa;
        font-size: 13px;
        margin-top: 10px;
    }

    .nx-reports-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 54px;
        height: 54px;
        border-radius: 13px;
        background: #302547;
        color: #c4b5fd;
        font-size: 26px;
        flex-shrink: 0;
    }


    /* İSTATİSTİKLER */
    .nx-reports-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 26px;
    }

    .nx-reports-stat-card {
        display: flex;
        flex-direction: column;
        gap: 14px;
        background: #1a1a20;
        border: 1px solid #303039;
        border-radius: 13px;
        padding: 23px;
    }

        .nx-reports-stat-card span {
            color: #a1a1aa;
            font-size: 12px;
        }

        .nx-reports-stat-card strong {
            color: #f5f5f5;
            font-size: 33px;
            font-weight: 800;
        }

        .nx-reports-stat-card small {
            color: #a78bfa;
            font-size: 11px;
        }

        .nx-reports-stat-card .nx-report-yellow {
            color: #facc15;
        }

        .nx-reports-stat-card .nx-report-green {
            color: #86efac;
        }


    /* TABLO PANELİ */
    .nx-reports-panel {
        background: #19191f;
        border: 1px solid #303039;
        border-radius: 14px;
        overflow: hidden;
        margin-bottom: 25px;
    }

    .nx-reports-panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 23px;
        border-bottom: 1px solid #303039;
    }

        .nx-reports-panel-header h2 {
            margin: 0;
            color: #f5f5f5;
            font-size: 17px;
        }

        .nx-reports-panel-header p {
            margin: 8px 0 0;
            color: #a1a1aa;
            font-size: 12px;
        }

        .nx-reports-panel-header > span {
            color: #a1a1aa;
            font-size: 12px;
            white-space: nowrap;
        }


    /* TABLO */
    .nx-reports-table-wrap {
        overflow-x: auto;
    }

    .nx-reports-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
    }

        .nx-reports-table th {
            padding: 17px 18px;
            background: #202027;
            color: #a1a1aa;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
        }

        .nx-reports-table td {
            padding: 18px;
            color: #d4d4d8;
            font-size: 12px;
            border-top: 1px solid #303039;
        }

        .nx-reports-table tbody tr:hover {
            background: #23232c;
        }

    .nx-report-id {
        color: #c4b5fd;
        font-weight: 700;
    }

    .nx-report-reason {
        color: #f5f5f5;
        font-weight: 600;
    }

    .nx-report-date {
        white-space: nowrap;
        color: #a1a1aa;
    }


    /* DURUM ETİKETLERİ */
    .nx-report-status {
        display: inline-block;
        padding: 8px 11px;
        border-radius: 7px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

        .nx-report-status.pending {
            background: #423818;
            color: #facc15;
        }

        .nx-report-status.reviewed {
            background: #19372b;
            color: #86efac;
        }


    /* BOŞ LİSTE */
    .nx-reports-empty {
        padding: 55px 20px;
        text-align: center;
    }

    .nx-reports-empty-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 55px;
        height: 55px;
        margin: 0 auto 18px;
        border-radius: 50%;
        background: #19372b;
        color: #86efac;
        font-size: 25px;
    }

    .nx-reports-empty h3 {
        color: #f5f5f5;
        font-size: 17px;
        margin-bottom: 10px;
    }

    .nx-reports-empty p {
        color: #a1a1aa;
        font-size: 12px;
    }


    /* GERİ DÖN */
    .nx-reports-back {
        display: inline-block;
        color: #a78bfa;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
    }

        .nx-reports-back:hover {
            color: #c4b5fd;
        }


    /* RESPONSIVE */
    @@media (max-width: 1000px) {

        .nx-reports-stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .nx-reports-table {
            min-width: 850px;
        }
    }

    @@media (max-width: 650px) {

        .nx-reports-page {
            padding: 16px;
        }

        .nx-reports-header {
            align-items: flex-start;
        }

        .nx-reports-stats {
            grid-template-columns: 1fr;
        }

        .nx-reports-panel-header {
            align-items: flex-start;
            flex-direction: column;
        }
    }

</style>
