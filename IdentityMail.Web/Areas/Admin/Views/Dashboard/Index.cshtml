@model IdentityMail.Web.Areas.Admin.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<section class="nx-admin-dashboard">

    <!-- SAYFA BAŞLIĞI -->
    <div class="nx-admin-header">

        <div>
            <span class="nx-admin-eyebrow">
                NEXORA / ADMIN PANEL
            </span>

            <h1>Dashboard</h1>

            <p>
                Nexora sisteminin genel durumunu
                buradan takip edebilirsin.
            </p>
        </div>

        <div class="nx-admin-shield">
            ★ ADMIN
        </div>

    </div>


    <!-- İSTATİSTİK KARTLARI -->
    <div class="nx-admin-stats" id="mesaj-istatistikleri">

        <!-- TOPLAM KULLANICI -->
        <div class="nx-admin-stat-card">

            <div class="nx-admin-stat-label">
                Toplam Kullanıcı
            </div>

            <div class="nx-admin-stat-value">
                @Model.TotalUsers
            </div>

            <span class="nx-admin-stat-note">
                Kayıtlı hesaplar
            </span>

        </div>


        <!-- AKTİF KULLANICI -->
        <div class="nx-admin-stat-card">

            <div class="nx-admin-stat-label">
                Aktif Kullanıcı
            </div>

            <div class="nx-admin-stat-value nx-value-green">
                @Model.ActiveUsers
            </div>

            <span class="nx-admin-stat-note">
                Pasife alınmamış hesaplar
            </span>

        </div>


        <!-- TOPLAM MESAJ -->
        <div class="nx-admin-stat-card">

            <div class="nx-admin-stat-label">
                Toplam Mesaj
            </div>

            <div class="nx-admin-stat-value">
                @Model.TotalMessages
            </div>

            <span class="nx-admin-stat-note">
                Sistemdeki tüm mesajlar
            </span>

        </div>


        <!-- BUGÜN GÖNDERİLEN MESAJLAR -->
        <div class="nx-admin-stat-card">

            <div class="nx-admin-stat-label">
                Bugün Gönderilen
            </div>

            <div class="nx-admin-stat-value">
                @Model.TodayMessages
            </div>

            <span class="nx-admin-stat-note">
                Bugünkü mesaj trafiği
            </span>

        </div>


        <!-- OKUNMAMIŞ MESAJLAR -->
        <div class="nx-admin-stat-card">

            <div class="nx-admin-stat-label">
                Okunmamış Mesaj
            </div>

            <div class="nx-admin-stat-value nx-value-yellow">
                @Model.UnreadMessages
            </div>

            <span class="nx-admin-stat-note">
                Henüz açılmamış mesajlar
            </span>

        </div>


        <!-- ÇÖP KUTUSU -->
        <div class="nx-admin-stat-card">

            <div class="nx-admin-stat-label">
                Çöp Kutusundaki Mesaj
            </div>

            <div class="nx-admin-stat-value nx-value-red">
                @Model.TrashedMessages
            </div>

            <span class="nx-admin-stat-note">
                Çöp kutusuna taşınanlar
            </span>

        </div>

    </div>


    <!-- DETAYLI İSTATİSTİKLER -->
    <div class="nx-admin-reports">

        <!-- EN ÇOK MESAJ GÖNDERENLER -->
        <div class="nx-admin-report-card">

            <div class="nx-admin-report-header">

                <div>
                    <h2>En Çok Mesaj Gönderenler</h2>

                    <p>
                        Sistemde en fazla mesaj
                        gönderen 5 kullanıcı.
                    </p>
                </div>

                <span class="nx-admin-report-badge">
                    TOP 5
                </span>

            </div>


            @if (Model.TopSenders.Count == 0)
            {
                <div class="nx-admin-empty">
                    Henüz gönderilmiş mesaj bulunmuyor.
                </div>
            }
            else
            {
                <div class="nx-admin-report-list">

                    @{
                        var senderRank = 1;
                    }

                    @foreach (var sender in Model.TopSenders)
                    {
                        var senderName =
                            string.IsNullOrWhiteSpace(sender.Name)
                                ? "İsimsiz Kullanıcı"
                                : sender.Name.Trim();

                        <div class="nx-admin-report-row">

                            <div class="nx-admin-report-left">

                                <div class="nx-admin-rank">
                                    @senderRank
                                </div>

                                <div class="nx-admin-report-info">

                                    <a href="@Url.Action(
                                        "Details",
                                        "Users",
                                        new
                                        {
                                            area = "Admin",
                                            id = sender.UserId
                                        })">

                                        @senderName

                                    </a>

                                    <span>
                                        Kullanıcı
                                    </span>

                                </div>

                            </div>


                            <div class="nx-admin-report-count">

                                <strong>
                                    @sender.MessageCount
                                </strong>

                                <span>mesaj</span>

                            </div>

                        </div>

                        senderRank++;
                    }

                </div>
            }

        </div>


        <!-- EN ÇOK KULLANILAN KATEGORİLER -->
        <div class="nx-admin-report-card">

            <div class="nx-admin-report-header">

                <div>
                    <h2>En Çok Kullanılan Kategoriler</h2>

                    <p>
                        Mesajlara en fazla atanan
                        kategori isimleri.
                    </p>
                </div>

                <span class="nx-admin-report-badge">
                    TOP 5
                </span>

            </div>


            @if (Model.TopCategories.Count == 0)
            {
                <div class="nx-admin-empty">
                    Henüz mesajlara atanmış kategori bulunmuyor.
                </div>
            }
            else
            {
                <div class="nx-admin-report-list">

                    @{
                        var categoryRank = 1;
                    }

                    @foreach (var category in Model.TopCategories)
                    {
                        <div class="nx-admin-report-row">

                            <div class="nx-admin-report-left">

                                <div class="nx-admin-rank">
                                    @categoryRank
                                </div>

                                <div class="nx-admin-report-info">

                                    <strong>
                                        @category.CategoryName
                                    </strong>

                                    <span>
                                        Mesaj kategorisi
                                    </span>

                                </div>

                            </div>


                            <div class="nx-admin-report-count">

                                <strong>
                                    @category.UsageCount
                                </strong>

                                <span>atama</span>

                            </div>

                        </div>

                        categoryRank++;
                    }

                </div>
            }

        </div>

    </div>


    <!-- YÖNETİM MERKEZİ -->
    <div class="nx-admin-panel">

        <div class="nx-admin-panel-header">

            <h2>Yönetim Merkezi</h2>

            <p>
                Nexora sistemini yönetebileceğin alanlar.
            </p>

        </div>


        <div class="nx-admin-actions">

            <!-- KULLANICI YÖNETİMİ -->
            <a href="@Url.Action(
                    "Index",
                    "Users",
                    new { area = "Admin" })"
               class="nx-admin-action-card">

                <div class="nx-admin-action-icon">
                    ♙
                </div>

                <h3>Kullanıcı Yönetimi</h3>

                <p>
                    Kayıtlı kullanıcıları görüntüle,
                    rollerini düzenle ve hesap durumlarını yönet.
                </p>

                <span class="nx-admin-action-link">
                    Kullanıcıları Gör →
                </span>

            </a>


            <!-- MESAJ İSTATİSTİKLERİ -->
            <a href="#mesaj-istatistikleri"
               class="nx-admin-action-card">

                <div class="nx-admin-action-icon">
                    ✉
                </div>

                <h3>Mesaj İstatistikleri</h3>

                <p>
                    Toplam, günlük ve okunmamış mesaj
                    sayılarını görüntüle.
                </p>

                <span class="nx-admin-action-link">
                    İstatistiklere Git →
                </span>

            </a>

        </div>

    </div>


    <!-- KULLANICI PANELİNE DÖN -->
    <a href="@Url.Action(
            "Index",
            "Message",
            new { area = "" })"
       class="nx-admin-back">

        ← Kullanıcı Paneline Dön

    </a>

</section>


<style>

    /* ANA SAYFA */
    .nx-admin-dashboard {
        padding: 30px;
        max-width: 1400px;
        margin: 0 auto;
    }

    .nx-admin-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
    }

    .nx-admin-eyebrow {
        display: block;
        color: #8b5cf6;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.4px;
        margin-bottom: 10px;
    }

    .nx-admin-header h1 {
        margin: 0;
        color: #f5f5f5;
        font-size: 30px;
        font-weight: 800;
    }

    .nx-admin-header p {
        margin-top: 8px;
        color: #9494a5;
        font-size: 14px;
    }

    .nx-admin-shield {
        background: #27213c;
        color: #c4b5fd;
        border: 1px solid #44365f;
        border-radius: 10px;
        padding: 12px 16px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }


    /* İSTATİSTİK KARTLARI */
    .nx-admin-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 28px;
    }

    .nx-admin-stat-card {
        background: #1a1a20;
        border: 1px solid #303039;
        border-radius: 14px;
        padding: 23px;
        transition: border-color 0.2s ease;
    }

        .nx-admin-stat-card:hover {
            border-color: #6d48ba;
        }

    .nx-admin-stat-label {
        color: #a1a1aa;
        font-size: 13px;
        margin-bottom: 18px;
    }

    .nx-admin-stat-value {
        color: #f5f5f5;
        font-size: 34px;
        font-weight: 800;
        margin-bottom: 10px;
    }

    .nx-admin-stat-note {
        color: #a78bfa;
        font-size: 11px;
    }

    .nx-value-green {
        color: #86efac;
    }

    .nx-value-yellow {
        color: #facc15;
    }

    .nx-value-red {
        color: #fca5a5;
    }


    /* DETAYLI RAPORLAR */
    .nx-admin-reports {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 28px;
    }

    .nx-admin-report-card {
        background: #1a1a20;
        border: 1px solid #303039;
        border-radius: 14px;
        padding: 24px;
        min-width: 0;
    }

    .nx-admin-report-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 24px;
    }

        .nx-admin-report-header h2 {
            color: #f5f5f5;
            font-size: 17px;
            font-weight: 700;
            margin: 0 0 9px;
        }

        .nx-admin-report-header p {
            color: #a1a1aa;
            font-size: 12px;
            line-height: 1.6;
            margin: 0;
        }

    .nx-admin-report-badge {
        padding: 7px 10px;
        border-radius: 7px;
        background: #302547;
        color: #c4b5fd;
        font-size: 10px;
        font-weight: 700;
        white-space: nowrap;
    }

    .nx-admin-report-list {
        display: flex;
        flex-direction: column;
    }

    .nx-admin-report-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 15px 0;
        border-top: 1px solid #303039;
    }

    .nx-admin-report-left {
        display: flex;
        align-items: center;
        gap: 13px;
        min-width: 0;
    }

    .nx-admin-rank {
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 9px;
        background: #302547;
        color: #c4b5fd;
        font-size: 12px;
        font-weight: 800;
    }

    .nx-admin-report-info {
        display: flex;
        flex-direction: column;
        gap: 6px;
        min-width: 0;
    }

        .nx-admin-report-info strong,
        .nx-admin-report-info a {
            color: #f5f5f5;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            overflow-wrap: anywhere;
        }

            .nx-admin-report-info a:hover {
                color: #c4b5fd;
            }

        .nx-admin-report-info span {
            color: #8b8b98;
            font-size: 11px;
        }

    .nx-admin-report-count {
        display: flex;
        align-items: baseline;
        gap: 5px;
        white-space: nowrap;
    }

        .nx-admin-report-count strong {
            color: #c4b5fd;
            font-size: 17px;
            font-weight: 800;
        }

        .nx-admin-report-count span {
            color: #a1a1aa;
            font-size: 11px;
        }

    .nx-admin-empty {
        padding: 30px 10px;
        color: #a1a1aa;
        font-size: 13px;
        text-align: center;
        border-top: 1px solid #303039;
    }


    /* YÖNETİM MERKEZİ */
    .nx-admin-panel {
        background: #18181d;
        border: 1px solid #303039;
        border-radius: 14px;
        padding: 25px;
        margin-bottom: 25px;
    }

    .nx-admin-panel-header {
        margin-bottom: 22px;
    }

        .nx-admin-panel-header h2 {
            color: #f5f5f5;
            font-size: 18px;
            margin: 0 0 8px;
        }

        .nx-admin-panel-header p {
            color: #a1a1aa;
            font-size: 13px;
            margin: 0;
        }

    .nx-admin-actions {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .nx-admin-action-card {
        display: block;
        border: 1px solid #34343c;
        border-radius: 12px;
        padding: 22px;
        background: #202027;
        text-decoration: none;
        transition: border-color 0.2s ease;
    }

        .nx-admin-action-card:hover {
            border-color: #8b5cf6;
            text-decoration: none;
        }

    .nx-admin-action-icon {
        color: #c4b5fd;
        font-size: 23px;
        margin-bottom: 14px;
    }

    .nx-admin-action-card h3 {
        margin: 0 0 8px;
        color: #f5f5f5;
        font-size: 15px;
    }

    .nx-admin-action-card p {
        color: #a1a1aa;
        font-size: 12px;
        line-height: 1.7;
        margin-bottom: 15px;
    }

    .nx-admin-action-link {
        display: inline-block;
        padding: 7px 11px;
        border-radius: 6px;
        background: #302845;
        color: #c4b5fd;
        font-size: 11px;
        font-weight: 600;
    }


    /* GERİ DÖN */
    .nx-admin-back {
        display: inline-block;
        color: #a78bfa;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
    }

        .nx-admin-back:hover {
            color: #c4b5fd;
        }


    /* RESPONSIVE */
    @@media (max-width: 1000px) {

        .nx-admin-stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .nx-admin-reports {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 650px) {

        .nx-admin-dashboard {
            padding: 18px;
        }

        .nx-admin-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .nx-admin-stats,
        .nx-admin-actions {
            grid-template-columns: 1fr;
        }

        .nx-admin-panel,
        .nx-admin-report-card {
            padding: 18px;
        }
    }

</style>
